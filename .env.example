# ---------------------------------------------------------------------------
# AI Auto Editor Pro — environment configuration
# Copy to .env and fill in. Values shown are the development defaults.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Database --------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aiedit
DATABASE_SSL=false
DATABASE_POOL_MAX=20

# --- Redis (BullMQ queues, progress pub/sub, locks) -------------------------
REDIS_URL=redis://localhost:6379

# --- Security --------------------------------------------------------------
# Required in production. Generate with: openssl rand -base64 48
JWT_SECRET=dev-only-insecure-jwt-secret-change-me
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=30d
# 32 bytes, hex or base64. Encrypts stored Gemini API keys at rest.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# --- Google sign-in (optional) ---------------------------------------------
GOOGLE_CLIENT_ID=

# --- Storage ---------------------------------------------------------------
# local | s3   (s3 also covers Cloudflare R2 and any S3-compatible store)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

S3_BUCKET=
S3_REGION=auto
# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Set when the bucket is fronted by a public CDN; skips URL signing.
S3_PUBLIC_BASE_URL=

# --- Media pipeline --------------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
RENDER_TMP_DIR=./tmp/renders
UPLOAD_TMP_DIR=./tmp/uploads
MAX_UPLOAD_BYTES=2147483648

RENDER_CONCURRENCY=2
GENERATION_CONCURRENCY=4
ANALYSIS_CONCURRENCY=4

# --- Gemini ----------------------------------------------------------------
GEMINI_API_BASE=https://generativelanguage.googleapis.com
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_REASONING_MODEL=gemini-2.5-pro
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_VIDEO_MODEL=veo-3.1-generate-preview
GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=180000
GEMINI_VIDEO_POLL_INTERVAL_MS=10000
GEMINI_VIDEO_TIMEOUT_MS=900000

# Optional single-tenant fallback used only when a user has no keys of their
# own. Per-user keys added through API Management always take priority.
GEMINI_FALLBACK_API_KEY=

# --- Observability and limits ----------------------------------------------
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# --- Cost model (admin dashboard estimates, USD) ---------------------------
COST_PER_IMAGE_USD=0.039
COST_PER_CLIP_SECOND_USD=0.35
COST_PER_AUDIO_MINUTE_USD=0.006
COST_PER_MTOK_INPUT_USD=0.3
COST_PER_MTOK_OUTPUT_USD=2.5

# --- Web app ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
